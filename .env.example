# ========================================================
# Video Template Studio - Environment Variables
# ========================================================

# PostgreSQL Database Connection String (Optional, e.g. Neon, Supabase, Railway, or local)
# If left empty, the application will automatically fall back to high-performance local data!
DATABASE_URL=postgresql://user:password@localhost:5432/videotemplates

# WhatsApp Business / Admin Number (Format: 628xxxxxxxxxx without leading 0 or +)
NEXT_PUBLIC_WA_NUMBER=628123456789

# Port for standalone Express server (Optional, default 5000)
PORT=5000
